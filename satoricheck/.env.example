# ===========================================
# Authenix Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# REQUIRED - Core Settings
# -------------------------------------------

# Flask secret key for session encryption (generate a random one!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-change-this-in-production

# Google Gemini API key for fact-checking AI
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key

# Database connection string
# Development: sqlite:///authenix.db
# Production: postgresql://user:password@host:5432/authenix
DATABASE_URL=sqlite:///authenix.db

# -------------------------------------------
# OPTIONAL - Live Pro (Premium Transcription)
# -------------------------------------------

# Deepgram API key for Live Pro transcription
# Get from: https://console.deepgram.com/
# Leave empty to disable Live Pro feature
DEEPGRAM_API_KEY=

# -------------------------------------------
# OPTIONAL - Google OAuth (Production Login)
# -------------------------------------------

# Google OAuth credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------
# OPTIONAL - Stripe (Payments)
# -------------------------------------------

# Stripe API keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe webhook secret for verifying webhook signatures
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Scheduler secret for Cloud Scheduler cron jobs (wizard-refill endpoint)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must match the X-Scheduler-Secret header in your Cloud Scheduler job
SCHEDULER_SECRET=your-scheduler-secret

# -------------------------------------------
# APPLICATION MODE
# -------------------------------------------

# Environment: development | production
ENV=development

# Test mode: true = skip API validation, use test user
# Set to false in production!
TEST_MODE=true

# -------------------------------------------
# SERVER SETTINGS
# -------------------------------------------

# Server port (Cloud Run sets PORT automatically)
PORT=8000

# Host binding (use 0.0.0.0 for Docker/Cloud Run)
HOST=127.0.0.1
